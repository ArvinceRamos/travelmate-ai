# Frontend values (apps/web/.env)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-travelmate.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-travelmate
VITE_FIREBASE_STORAGE_BUCKET=demo-travelmate.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key
VITE_USE_FIREBASE_EMULATORS=true
VITE_ENABLE_AVATAR_UPLOADS=false
VITE_FUNCTIONS_REGION=asia-southeast1
VITE_API_BASE_URL=
VITE_PHOTON_BASE_URL=https://photon.komoot.io/api/
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Backend values (apps/functions/.env)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://travelmate-ai-psi.vercel.app
PHOTON_BASE_URL=https://photon.komoot.io/api/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TravelmateAI/1.0 (replace-with-contact-email)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
FREE_PROVIDER_CACHE_TTL_MS=300000
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_BASE_URL=http://127.0.0.1:11434
AI_MAX_TOKENS=2500
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
GEMINI_API_KEY=your-gemini-api-key

# Firebase CLI function discovery for this large source module
FUNCTIONS_DISCOVERY_TIMEOUT=30

# Optional backend behavior
LLM_FIRST_INTAKE=false
MAP_STOPS_HARDCODED_FALLBACK=false
NATURAL_INTAKE_REPLIES=true
SEMANTIC_INTENT_ROUTER_MODE=shadow
STRUCTURED_INTAKE_UNDERSTANDING=false
TRAVELMATE_DUPLICATE_REPAIR_ATTEMPTS=0
TRAVELMATE_PROVIDER_EMERGENCY_REPAIR=false
TRAVELMATE_PROVIDER_FREE_FALLBACK=false
TRAVELMATE_PROVIDER_FREE_ITINERARY_FALLBACK=false
TRAVELMATE_PROVIDER_REPAIR_ATTEMPTS=0
TRAVELMATE_TERMINAL_REPAIR_ATTEMPTS=0
